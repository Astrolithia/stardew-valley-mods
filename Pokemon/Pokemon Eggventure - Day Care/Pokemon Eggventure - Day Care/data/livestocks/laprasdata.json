{
  "Changes": [
    {
      "LogName": "Load lapras textures",
      "Action": "Load",
      "Target": "{{ModId}}/lapras/lapras, {{ModId}}/lapras/shinylapras, {{ModId}}/lapras/laprasegg",
      "FromFile": "assets/livestocks/lapras/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_lapras data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_lapras": {
          "DisplayName": "{{i18n: lapras}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_laprasegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: laprasbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/lapras/lapras",
          "BabyTexture": "{{ModId}}/lapras/lapras",
          "Sound": "{{ModId}}_laprascry",
          "BabySound": "{{ModId}}_laprascry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
