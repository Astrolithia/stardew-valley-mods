          "BirthText": "{{i18n: minccinobirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/minccino/cinccino",
          "BabyTexture": "{{ModId}}/minccino/minccino",
          "Sound": "{{ModId}}_cinccinocry",
          "BabySound": "{{ModId}}_minccinocry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
