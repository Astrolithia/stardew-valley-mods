    {
      "LogName": "delibird cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_delibirdcry": {
          "ID": "{{ModId}}_delibirdcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/delibird/delibirdcry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "delibird egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_delibirdegg": {
          "Name": "{{ModId}}_delibirdegg",
          "DisplayName": "{{i18n: delibirdegg}}",
          "Description": "{{i18n: delibirdegg.d}}",
          "Texture": "{{ModId}}/delibird/delibirdegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_type_ice",
            "pkegg_rarity_rare",
            "color_blue"
          ]
        }
      }
    },
    {
      "LogName": "delibird hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_delibirdegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinydelibird",
              "AnimalId": "{{ModId}}_shinydelibird",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_delibird",
              "AnimalId": "{{ModId}}_delibird",
              "Condition": null
            }
          ]
