        "{{ModId}}_spoink": {
          "DisplayName": "{{i18n: spoink}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_spoinkegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
