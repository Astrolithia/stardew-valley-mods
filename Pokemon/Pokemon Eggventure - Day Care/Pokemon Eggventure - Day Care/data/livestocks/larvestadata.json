          "Sound": "{{ModId}}_volcaronacry",
          "BabySound": "{{ModId}}_larvestacry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
