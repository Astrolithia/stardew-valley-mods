    {
      "LogName": "mrmime cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_mimejrcry": {
          "ID": "{{ModId}}_mimejrcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/mimejr/mimejrcry.ogg}}"
          ]
        },
        "{{ModId}}_mrmimecry": {
          "ID": "{{ModId}}_mrmimecry",
          "Category": "Sound",
