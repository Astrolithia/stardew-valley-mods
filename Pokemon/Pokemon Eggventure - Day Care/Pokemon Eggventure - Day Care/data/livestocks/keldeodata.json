          "Sound": "{{ModId}}_keldeocry",
          "BabySound": "{{ModId}}_keldeocry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
