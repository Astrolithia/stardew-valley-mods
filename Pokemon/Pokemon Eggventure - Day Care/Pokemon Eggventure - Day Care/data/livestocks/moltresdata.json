          "DisplayName": "{{i18n: moltres}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_moltresegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysLegendary}} * 1440}}",
