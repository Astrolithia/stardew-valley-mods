          "CanGetPregnant": false,
          "Texture": "{{ModId}}/pinsir/pinsir",
          "BabyTexture": "{{ModId}}/pinsir/pinsir",
          "Sound": "{{ModId}}_pinsircry",
          "BabySound": "{{ModId}}_pinsircry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
