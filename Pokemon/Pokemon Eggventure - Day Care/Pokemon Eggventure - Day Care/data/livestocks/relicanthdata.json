      }
    },
    {
      "LogName": "relicanth hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_relicanthegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyrelicanth",
              "AnimalId": "{{ModId}}_shinyrelicanth",
