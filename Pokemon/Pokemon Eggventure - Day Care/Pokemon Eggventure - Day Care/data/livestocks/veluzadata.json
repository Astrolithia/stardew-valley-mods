{
  "Changes": [
    {
      "LogName": "Load veluza textures",
      "Action": "Load",
      "Target": "{{ModId}}/veluza/veluza, {{ModId}}/veluza/shinyveluza, {{ModId}}/veluza/veluzaegg",
      "FromFile": "assets/livestocks/veluza/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_veluza data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_veluza": {
          "DisplayName": "{{i18n: veluza}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_veluzaegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: veluzabirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/veluza/veluza",
          "BabyTexture": "{{ModId}}/veluza/veluza",
          "Sound": "{{ModId}}_veluzacry",
          "BabySound": "{{ModId}}_veluzacry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_veluzaegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_veluza type flags",
