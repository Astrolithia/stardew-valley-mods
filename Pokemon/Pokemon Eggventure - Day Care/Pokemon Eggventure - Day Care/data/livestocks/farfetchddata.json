{
  "Changes": [
    {
      "LogName": "Load farfetchd textures",
      "Action": "Load",
      "Target": "{{ModId}}/farfetchd/farfetchd, {{ModId}}/farfetchd/shinyfarfetchd, {{ModId}}/farfetchd/sirfetchd, {{ModId}}/farfetchd/shinysirfetchd, {{ModId}}/farfetchd/farfetchdegg",
      "FromFile": "assets/livestocks/farfetchd/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_farfetchd data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_farfetchd": {
          "DisplayName": "{{i18n: farfetchd}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_farfetchdegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: farfetchdbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/farfetchd/sirfetchd",
          "BabyTexture": "{{ModId}}/farfetchd/farfetchd",
          "Sound": "{{ModId}}_sirfetchdcry",
          "BabySound": "{{ModId}}_farfetchdcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_blackbelt",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_farfetchdegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
