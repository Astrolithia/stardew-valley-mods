        "{{ModId}}_frillish": {
          "DisplayName": "{{i18n: frillish}}",
          "Gender": "Male",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_frillishegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: frillishbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/frillish/jellicent",
