{
  "Changes": [
    {
      "LogName": "Load lillipup textures",
      "Action": "Load",
      "Target": "{{ModId}}/lillipup/lillipup, {{ModId}}/lillipup/shinylillipup, {{ModId}}/lillipup/herdier, {{ModId}}/lillipup/shinyherdier, {{ModId}}/lillipup/stoutland, {{ModId}}/lillipup/shinystoutland, {{ModId}}/lillipup/lillipupegg",
      "FromFile": "assets/livestocks/lillipup/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_lillipup data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_lillipup": {
          "DisplayName": "{{i18n: lillipup}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_lillipupegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: lillipupbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/lillipup/herdier",
          "BabyTexture": "{{ModId}}/lillipup/lillipup",
          "Sound": "{{ModId}}_stoutlandcry",
          "BabySound": "{{ModId}}_lillipupcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_quickclaw",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_lillipupegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_lillipup evolution appearance",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_lillipup",
        "TextureOverrides"
