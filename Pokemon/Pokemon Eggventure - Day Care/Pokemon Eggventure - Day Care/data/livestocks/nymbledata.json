{
  "Changes": [
    {
      "LogName": "Load nymble textures",
      "Action": "Load",
      "Target": "{{ModId}}/nymble/nymble, {{ModId}}/nymble/shinynymble, {{ModId}}/nymble/lokix, {{ModId}}/nymble/shinylokix, {{ModId}}/nymble/nymbleegg",
      "FromFile": "assets/livestocks/nymble/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_nymble data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_nymble": {
          "DisplayName": "{{i18n: nymble}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_nymbleegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: nymblebirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/nymble/lokix",
          "BabyTexture": "{{ModId}}/nymble/nymble",
          "Sound": "{{ModId}}_lokixcry",
          "BabySound": "{{ModId}}_nymblecry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
