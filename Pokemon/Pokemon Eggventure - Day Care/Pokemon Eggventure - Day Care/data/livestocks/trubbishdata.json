    {
      "LogName": "trubbish cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_trubbishcry": {
          "ID": "{{ModId}}_trubbishcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/trubbish/trubbishcry.ogg}}"
          ]
        },
        "{{ModId}}_garbodorcry": {
          "ID": "{{ModId}}_garbodorcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/trubbish/garbodorcry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "trubbish egg",
      "Action": "EditData",
