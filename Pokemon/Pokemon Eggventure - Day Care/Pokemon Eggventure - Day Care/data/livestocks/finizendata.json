{
  "Changes": [
    {
      "LogName": "Load finizen textures",
      "Action": "Load",
      "Target": "{{ModId}}/finizen/finizen, {{ModId}}/finizen/shinyfinizen, {{ModId}}/finizen/palafin, {{ModId}}/finizen/shinypalafin, {{ModId}}/finizen/finizenegg",
      "FromFile": "assets/livestocks/finizen/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_finizen data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_finizen": {
          "DisplayName": "{{i18n: finizen}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_finizenegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: finizenbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/finizen/palafin",
          "BabyTexture": "{{ModId}}/finizen/finizen",
          "Sound": "{{ModId}}_palafincry",
          "BabySound": "{{ModId}}_finizencry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_finizenegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_finizen type flags",
