    {
      "LogName": "farfetchd cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_farfetchdcry": {
          "ID": "{{ModId}}_farfetchdcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/farfetchd/farfetchdcry.ogg}}"
          ]
        },
        "{{ModId}}_sirfetchdcry": {
          "ID": "{{ModId}}_sirfetchdcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/farfetchd/sirfetchdcry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "farfetchd egg",
      "Action": "EditData",
