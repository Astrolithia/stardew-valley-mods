{
  "Changes": [
    {
      "LogName": "Load piplup textures",
      "Action": "Load",
      "Target": "{{ModId}}/piplup/piplup, {{ModId}}/piplup/shinypiplup, {{ModId}}/piplup/prinplup, {{ModId}}/piplup/shinyprinplup, {{ModId}}/piplup/empoleon, {{ModId}}/piplup/shinyempoleon, {{ModId}}/piplup/piplupegg",
      "FromFile": "assets/livestocks/piplup/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_piplup data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_piplup": {
          "DisplayName": "{{i18n: piplup}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_piplupegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: piplupbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/piplup/prinplup",
          "BabyTexture": "{{ModId}}/piplup/piplup",
          "Sound": "{{ModId}}_empoleoncry",
          "BabySound": "{{ModId}}_piplupcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_piplupegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_piplup evolution appearance",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_piplup",
        "TextureOverrides"
      ],
      "Entries": {
        "piplupevolution": {
          "Id": "piplupevolution",
          "Condition": "selph.ExtraAnimalConfig_ANIMAL_FRIENDSHIP {{Query: {{EvolutionHearts}} * 200}}",
          "TextureToUse": "{{ModId}}/piplup/empoleon"
        }
      }
    },
    {
