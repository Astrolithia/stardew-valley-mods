      "FromFile": "assets/livestocks/phantump/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_phantump data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_phantump": {
          "DisplayName": "{{i18n: phantump}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_phantumpegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: phantumpbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/phantump/trevenant",
