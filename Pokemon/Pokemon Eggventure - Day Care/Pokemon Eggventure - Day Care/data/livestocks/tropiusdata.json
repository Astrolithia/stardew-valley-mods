{
  "Changes": [
    {
      "LogName": "Load tropius textures",
      "Action": "Load",
      "Target": "{{ModId}}/tropius/tropius, {{ModId}}/tropius/shinytropius, {{ModId}}/tropius/tropiusegg",
      "FromFile": "assets/livestocks/tropius/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_tropius data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_tropius": {
          "DisplayName": "{{i18n: tropius}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_tropiusegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: tropiusbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/tropius/tropius",
          "BabyTexture": "{{ModId}}/tropius/tropius",
          "Sound": "{{ModId}}_tropiuscry",
          "BabySound": "{{ModId}}_tropiuscry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
