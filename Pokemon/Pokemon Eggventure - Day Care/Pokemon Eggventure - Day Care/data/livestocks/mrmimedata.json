{
  "Changes": [
    {
      "LogName": "Load mrmime textures",
      "Action": "Load",
      "Target": "{{ModId}}/mimejr/mimejr, {{ModId}}/mimejr/shinymimejr, {{ModId}}/mimejr/mmime, {{ModId}}/mimejr/shinymmime, {{ModId}}/mimejr/mrmimeegg",
      "FromFile": "assets/livestocks/mimejr/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_mrmime data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_mrmime": {
          "DisplayName": "{{i18n: mrmime}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_mrmimeegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: mrmimebirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/mimejr/mmime",
          "BabyTexture": "{{ModId}}/mimejr/mimejr",
          "Sound": "{{ModId}}_mrmimecry",
          "BabySound": "{{ModId}}_mimejrcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_nevermeltice",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_mrmimeegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_mrmime type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_mrmime"
      ],
      "Entries": {
        "IgnoreWinter": true
      }
    },
