      "Target": "{{ModId}}/keldeo/keldeo, {{ModId}}/keldeo/shinykeldeo, {{ModId}}/keldeo/keldeoegg",
      "FromFile": "assets/livestocks/keldeo/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_keldeo data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
