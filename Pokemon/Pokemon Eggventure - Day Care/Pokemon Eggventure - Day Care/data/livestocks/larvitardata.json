          "DisplayName": "{{i18n: larvitar}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_larvitaregg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
