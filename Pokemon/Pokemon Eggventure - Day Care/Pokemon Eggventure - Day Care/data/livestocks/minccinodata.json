              "ItemId": "{{ModId}}_wool_minccino",
              "MinimumFriendship": 0
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "PokemonEgg",
              "ItemId": "{{ModId}}_minccinoegg",
              "MinimumFriendship": 500,
              "Condition": "RANDOM {{EggLayingChance}}"
