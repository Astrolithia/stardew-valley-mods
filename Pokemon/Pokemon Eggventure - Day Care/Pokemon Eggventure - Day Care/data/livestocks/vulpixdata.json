{
  "Changes": [
    {
      "LogName": "Load vulpix textures",
      "Action": "Load",
      "Target": "{{ModId}}/vulpix/vulpix, {{ModId}}/vulpix/shinyvulpix, {{ModId}}/vulpix/ninetales, {{ModId}}/vulpix/shinyninetales, {{ModId}}/vulpix/vulpixegg",
      "FromFile": "assets/livestocks/vulpix/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_vulpix data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_vulpix": {
          "DisplayName": "{{i18n: vulpix}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_vulpixegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: vulpixbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/vulpix/ninetales",
          "BabyTexture": "{{ModId}}/vulpix/vulpix",
          "Sound": "{{ModId}}_ninetalescry",
          "BabySound": "{{ModId}}_vulpixcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_firecoal",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_vulpixegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_vulpix type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_vulpix"
      ],
      "Entries": {
        "IsHeater": true
      }
    },
    {
      "LogName": "Add {{ModId}}_shinyvulpix data",
