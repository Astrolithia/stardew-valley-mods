{
  "Changes": [
    {
      "LogName": "Load binacle textures",
      "Action": "Load",
      "Target": "{{ModId}}/binacle/binacle, {{ModId}}/binacle/shinybinacle, {{ModId}}/binacle/barbaracle, {{ModId}}/binacle/shinybarbaracle, {{ModId}}/binacle/binacleegg",
      "FromFile": "assets/livestocks/binacle/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_binacle data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_binacle": {
          "DisplayName": "{{i18n: binacle}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_binacleegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: binaclebirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/binacle/barbaracle",
          "BabyTexture": "{{ModId}}/binacle/binacle",
          "Sound": "{{ModId}}_barbaraclecry",
          "BabySound": "{{ModId}}_binaclecry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
