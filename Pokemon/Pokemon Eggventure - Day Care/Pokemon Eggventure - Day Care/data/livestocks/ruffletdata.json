          "ID": "{{ModId}}_ruffletcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/rufflet/ruffletcry.ogg}}"
          ]
        },
        "{{ModId}}_braviarycry": {
          "ID": "{{ModId}}_braviarycry",
          "Category": "Sound",
