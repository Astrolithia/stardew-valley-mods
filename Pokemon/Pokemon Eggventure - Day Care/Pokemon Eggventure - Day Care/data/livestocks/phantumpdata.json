          "Sound": "{{ModId}}_trevenantcry",
          "BabySound": "{{ModId}}_phantumpcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
