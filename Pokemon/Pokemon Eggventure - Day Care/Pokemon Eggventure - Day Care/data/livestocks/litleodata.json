{
  "Changes": [
    {
      "LogName": "Load litleo textures",
      "Action": "Load",
      "Target": "{{ModId}}/litleo/litleo, {{ModId}}/litleo/shinylitleo, {{ModId}}/litleo/pyroar, {{ModId}}/litleo/shinypyroar, {{ModId}}/litleo/litleoegg",
      "FromFile": "assets/livestocks/litleo/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_litleo data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_litleo": {
          "DisplayName": "{{i18n: litleo}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_litleoegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: litleobirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/litleo/pyroar",
          "BabyTexture": "{{ModId}}/litleo/litleo",
          "Sound": "{{ModId}}_pyroarcry",
          "BabySound": "{{ModId}}_litleocry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_firecoal",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_litleoegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_litleo type flags",
