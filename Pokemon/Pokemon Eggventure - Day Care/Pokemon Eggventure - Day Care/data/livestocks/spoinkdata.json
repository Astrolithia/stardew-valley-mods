          "Sound": "{{ModId}}_grumpigcry",
          "BabySound": "{{ModId}}_spoinkcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
