      "Target": "{{ModId}}/moltres/moltres, {{ModId}}/moltres/shinymoltres, {{ModId}}/moltres/moltresegg",
      "FromFile": "assets/livestocks/moltres/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_moltres data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
