{
  "Changes": [
    {
      "LogName": "Load spectrier textures",
      "Action": "Load",
      "Target": "{{ModId}}/spectrier/spectrier, {{ModId}}/spectrier/shinyspectrier, {{ModId}}/spectrier/spectrieregg",
      "FromFile": "assets/livestocks/spectrier/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_spectrier data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_spectrier": {
          "DisplayName": "{{i18n: spectrier}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_spectrieregg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysLegendary}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: spectrierbirthtext}}",
          "DaysToMature": "{{BabyDaysLegendary}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/spectrier/spectrier",
          "BabyTexture": "{{ModId}}/spectrier/spectrier",
          "Sound": "{{ModId}}_spectriercry",
          "BabySound": "{{ModId}}_spectriercry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
