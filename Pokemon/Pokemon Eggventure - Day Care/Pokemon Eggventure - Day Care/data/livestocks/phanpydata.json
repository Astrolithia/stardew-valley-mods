{
  "Changes": [
    {
      "LogName": "Load phanpy textures",
      "Action": "Load",
      "Target": "{{ModId}}/phanpy/phanpy, {{ModId}}/phanpy/shinyphanpy, {{ModId}}/phanpy/donphan, {{ModId}}/phanpy/shinydonphan, {{ModId}}/phanpy/phanpyegg",
      "FromFile": "assets/livestocks/phanpy/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_phanpy data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_phanpy": {
          "DisplayName": "{{i18n: phanpy}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_phanpyegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: phanpybirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/phanpy/donphan",
          "BabyTexture": "{{ModId}}/phanpy/phanpy",
          "Sound": "{{ModId}}_donphancry",
          "BabySound": "{{ModId}}_phanpycry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
