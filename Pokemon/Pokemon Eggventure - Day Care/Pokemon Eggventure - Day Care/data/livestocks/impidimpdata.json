{
  "Changes": [
    {
      "LogName": "Load impidimp textures",
      "Action": "Load",
      "Target": "{{ModId}}/impidimp/impidimp, {{ModId}}/impidimp/shinyimpidimp, {{ModId}}/impidimp/morgrem, {{ModId}}/impidimp/shinymorgrem, {{ModId}}/impidimp/grimmsnarl, {{ModId}}/impidimp/shinygrimmsnarl, {{ModId}}/impidimp/impidimpegg",
      "FromFile": "assets/livestocks/impidimp/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_impidimp data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_impidimp": {
          "DisplayName": "{{i18n: impidimp}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_impidimpegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: impidimpbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/impidimp/morgrem",
          "BabyTexture": "{{ModId}}/impidimp/impidimp",
          "Sound": "{{ModId}}_grimmsnarlcry",
          "BabySound": "{{ModId}}_impidimpcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_blackglasses",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_impidimpegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
