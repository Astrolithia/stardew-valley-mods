{
  "Changes": [
    {
      "LogName": "Load ironbundle textures",
      "Action": "Load",
      "Target": "{{ModId}}/ironbundle/ironbundle, {{ModId}}/ironbundle/shinyironbundle, {{ModId}}/ironbundle/ironbundleegg",
      "FromFile": "assets/livestocks/ironbundle/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_ironbundle data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_ironbundle": {
          "DisplayName": "{{i18n: ironbundle}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_ironbundleegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysLegendary}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: ironbundlebirthtext}}",
          "DaysToMature": "{{BabyDaysLegendary}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/ironbundle/ironbundle",
          "BabyTexture": "{{ModId}}/ironbundle/ironbundle",
          "Sound": "{{ModId}}_ironbundlecry",
          "BabySound": "{{ModId}}_ironbundlecry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_nevermeltice",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_ironbundleegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceLegendary}}"
        }
      }
    },
    {
