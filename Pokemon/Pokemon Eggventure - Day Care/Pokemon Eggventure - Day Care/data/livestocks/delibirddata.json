{
  "Changes": [
    {
      "LogName": "Load delibird textures",
      "Action": "Load",
      "Target": "{{ModId}}/delibird/delibird, {{ModId}}/delibird/shinydelibird, {{ModId}}/delibird/delibirdegg",
      "FromFile": "assets/livestocks/delibird/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_delibird data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_delibird": {
          "DisplayName": "{{i18n: delibird}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_delibirdegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: delibirdbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/delibird/delibird",
          "BabyTexture": "{{ModId}}/delibird/delibird",
          "Sound": "{{ModId}}_delibirdcry",
          "BabySound": "{{ModId}}_delibirdcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_nevermeltice",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_delibirdegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_delibird type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_delibird"
      ],
      "Entries": {
        "IgnoreWinter": true
      }
    },
