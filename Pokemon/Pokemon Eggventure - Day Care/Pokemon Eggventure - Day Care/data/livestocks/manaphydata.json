{
  "Changes": [
    {
      "LogName": "Load manaphy textures",
      "Action": "Load",
      "Target": "{{ModId}}/manaphy/manaphy, {{ModId}}/manaphy/shinymanaphy, {{ModId}}/manaphy/manaphyegg",
      "FromFile": "assets/livestocks/manaphy/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_manaphy data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_manaphy": {
          "DisplayName": "{{i18n: manaphy}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_manaphyegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysLegendary}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: manaphybirthtext}}",
          "DaysToMature": "{{BabyDaysLegendary}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/manaphy/manaphy",
          "BabyTexture": "{{ModId}}/manaphy/manaphy",
          "Sound": "{{ModId}}_manaphycry",
          "BabySound": "{{ModId}}_manaphycry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_manaphyegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceLegendary}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_manaphy type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_manaphy"
      ],
      "Entries": {
        "IgnoreRain": true
      }
