{
  "Changes": [
    {
      "LogName": "Load rufflet textures",
      "Action": "Load",
      "Target": "{{ModId}}/rufflet/rufflet, {{ModId}}/rufflet/shinyrufflet, {{ModId}}/rufflet/braviary, {{ModId}}/rufflet/shinybraviary, {{ModId}}/rufflet/ruffletegg",
      "FromFile": "assets/livestocks/rufflet/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_rufflet data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_rufflet": {
          "DisplayName": "{{i18n: rufflet}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_ruffletegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: ruffletbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/rufflet/braviary",
          "BabyTexture": "{{ModId}}/rufflet/rufflet",
          "Sound": "{{ModId}}_braviarycry",
          "BabySound": "{{ModId}}_ruffletcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_prettyfeather",
              "HarvestType": "DropOverNight"
            }
