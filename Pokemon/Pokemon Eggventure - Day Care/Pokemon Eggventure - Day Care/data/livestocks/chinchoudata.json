{
  "Changes": [
    {
      "LogName": "Load chinchou textures",
      "Action": "Load",
      "Target": "{{ModId}}/chinchou/chinchou, {{ModId}}/chinchou/shinychinchou, {{ModId}}/chinchou/lanturn, {{ModId}}/chinchou/shinylanturn, {{ModId}}/chinchou/chinchouegg",
      "FromFile": "assets/livestocks/chinchou/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_chinchou data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_chinchou": {
          "DisplayName": "{{i18n: chinchou}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_chinchouegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: chinchoubirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/chinchou/lanturn",
          "BabyTexture": "{{ModId}}/chinchou/chinchou",
          "Sound": "{{ModId}}_lanturncry",
          "BabySound": "{{ModId}}_chinchoucry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
