      "LogName": "cherubi hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_cherubiegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinycherubi",
              "AnimalId": "{{ModId}}_shinycherubi",
