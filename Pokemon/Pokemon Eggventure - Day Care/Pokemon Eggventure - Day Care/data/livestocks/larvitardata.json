{
  "Changes": [
    {
      "LogName": "Load larvitar textures",
      "Action": "Load",
      "Target": "{{ModId}}/larvitar/larvitar, {{ModId}}/larvitar/shinylarvitar, {{ModId}}/larvitar/pupitar, {{ModId}}/larvitar/shinypupitar, {{ModId}}/larvitar/tyranitar, {{ModId}}/larvitar/shinytyranitar, {{ModId}}/larvitar/larvitaregg",
