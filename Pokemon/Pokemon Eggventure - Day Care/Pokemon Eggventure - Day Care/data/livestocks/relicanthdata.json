{
  "Changes": [
    {
      "LogName": "Load relicanth textures",
      "Action": "Load",
      "Target": "{{ModId}}/relicanth/relicanth, {{ModId}}/relicanth/shinyrelicanth, {{ModId}}/relicanth/relicanthegg",
      "FromFile": "assets/livestocks/relicanth/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_relicanth data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_relicanth": {
          "DisplayName": "{{i18n: relicanth}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_relicanthegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: relicanthbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/relicanth/relicanth",
          "BabyTexture": "{{ModId}}/relicanth/relicanth",
          "Sound": "{{ModId}}_relicanthcry",
          "BabySound": "{{ModId}}_relicanthcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_relicanthegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryRare}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_relicanth type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_relicanth"
      ],
      "Entries": {
        "IgnoreRain": true
      }
    },
