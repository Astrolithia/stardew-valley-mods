{
  "Changes": [
    {
      "LogName": "Load luvdisc textures",
      "Action": "Load",
      "Target": "{{ModId}}/luvdisc/luvdisc, {{ModId}}/luvdisc/shinyluvdisc, {{ModId}}/luvdisc/luvdiscegg",
      "FromFile": "assets/livestocks/luvdisc/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_luvdisc data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_luvdisc": {
          "DisplayName": "{{i18n: luvdisc}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_luvdiscegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: luvdiscbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/luvdisc/luvdisc",
          "BabyTexture": "{{ModId}}/luvdisc/luvdisc",
          "Sound": "{{ModId}}_luvdisccry",
          "BabySound": "{{ModId}}_luvdisccry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_luvdiscegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_luvdisc type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_luvdisc"
      ],
      "Entries": {
        "IgnoreRain": true
      }
    },
    {
