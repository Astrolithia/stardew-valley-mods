          "Sound": "{{ModId}}_spindacry",
          "BabySound": "{{ModId}}_spindacry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
