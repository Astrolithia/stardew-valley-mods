{
  "Changes": [
    {
      "LogName": "Load zapdos textures",
      "Action": "Load",
      "Target": "{{ModId}}/zapdos/zapdos, {{ModId}}/zapdos/shinyzapdos, {{ModId}}/zapdos/zapdosegg",
      "FromFile": "assets/livestocks/zapdos/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_zapdos data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_zapdos": {
          "DisplayName": "{{i18n: zapdos}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_zapdosegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysLegendary}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: zapdosbirthtext}}",
          "DaysToMature": "{{BabyDaysLegendary}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/zapdos/zapdos",
          "BabyTexture": "{{ModId}}/zapdos/zapdos",
          "Sound": "{{ModId}}_zapdoscry",
          "BabySound": "{{ModId}}_zapdoscry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_magnet",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_zapdosegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceLegendary}}"
        }
      }
    },
    {
      "LogName": "Add {{ModId}}_shinyzapdos data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
