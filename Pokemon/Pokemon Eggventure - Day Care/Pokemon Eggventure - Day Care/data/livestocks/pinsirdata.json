        "{{ModId}}_pinsir": {
          "DisplayName": "{{i18n: pinsir}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_pinsiregg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: pinsirbirthtext}}",
