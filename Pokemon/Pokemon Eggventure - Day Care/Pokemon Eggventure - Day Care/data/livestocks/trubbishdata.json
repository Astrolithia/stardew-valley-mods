{
  "Changes": [
    {
      "LogName": "Load trubbish textures",
      "Action": "Load",
      "Target": "{{ModId}}/trubbish/trubbish, {{ModId}}/trubbish/shinytrubbish, {{ModId}}/trubbish/garbodor, {{ModId}}/trubbish/shinygarbodor, {{ModId}}/trubbish/trubbishegg",
      "FromFile": "assets/livestocks/trubbish/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_trubbish data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_trubbish": {
          "DisplayName": "{{i18n: trubbish}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_trubbishegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: trubbishbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/trubbish/garbodor",
          "BabyTexture": "{{ModId}}/trubbish/trubbish",
          "Sound": "{{ModId}}_garbodorcry",
          "BabySound": "{{ModId}}_trubbishcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
