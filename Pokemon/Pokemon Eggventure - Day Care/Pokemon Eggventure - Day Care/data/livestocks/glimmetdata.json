{
  "Changes": [
    {
      "LogName": "Load glimmet textures",
      "Action": "Load",
      "Target": "{{ModId}}/glimmet/glimmet, {{ModId}}/glimmet/shinyglimmet, {{ModId}}/glimmet/glimmora, {{ModId}}/glimmet/shinyglimmora, {{ModId}}/glimmet/glimmetegg",
      "FromFile": "assets/livestocks/glimmet/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_glimmet data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_glimmet": {
          "DisplayName": "{{i18n: glimmet}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_glimmetegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: glimmetbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/glimmet/glimmora",
          "BabyTexture": "{{ModId}}/glimmet/glimmet",
          "Sound": "{{ModId}}_glimmoracry",
          "BabySound": "{{ModId}}_glimmetcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_hardstone",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_glimmetegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
