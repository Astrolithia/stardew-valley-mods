        }
      }
    },
    {
      "LogName": "trubbish hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_trubbishegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinytrubbish",
              "AnimalId": "{{ModId}}_shinytrubbish",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_trubbish",
              "AnimalId": "{{ModId}}_trubbish",
              "Condition": null
            }
          ]
        }
