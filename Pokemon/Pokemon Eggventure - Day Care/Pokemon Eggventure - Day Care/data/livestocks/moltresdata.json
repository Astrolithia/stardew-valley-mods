          "Sound": "{{ModId}}_moltrescry",
          "BabySound": "{{ModId}}_moltrescry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
