    },
    {
      "LogName": "Add {{ModId}}_shellder data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_shellder": {
          "DisplayName": "{{i18n: shellder}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_shellderegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: shellderbirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/shellder/cloyster",
          "BabyTexture": "{{ModId}}/shellder/shellder",
          "Sound": "{{ModId}}_cloystercry",
          "BabySound": "{{ModId}}_shelldercry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
