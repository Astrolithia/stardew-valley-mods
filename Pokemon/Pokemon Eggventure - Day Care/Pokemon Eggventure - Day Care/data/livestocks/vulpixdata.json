          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/vulpix/shinyninetales",
          "BabyTexture": "{{ModId}}/vulpix/shinyvulpix",
          "Sound": "{{ModId}}_ninetalescry",
          "BabySound": "{{ModId}}_vulpixcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
