    {
      "LogName": "{{ModId}}_shinyluvdisc type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_shinyluvdisc"
      ],
      "Entries": {
        "IgnoreRain": true
      }
    },
    {
      "LogName": "luvdisc cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_luvdisccry": {
          "ID": "{{ModId}}_luvdisccry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/luvdisc/luvdisccry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "luvdisc egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_luvdiscegg": {
          "Name": "{{ModId}}_luvdiscegg",
          "DisplayName": "{{i18n: luvdiscegg}}",
          "Description": "{{i18n: luvdiscegg.d}}",
          "Texture": "{{ModId}}/luvdisc/luvdiscegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_travelingcart",
            "pkegg_type_water",
            "pkegg_rarity_verycommon",
            "color_blue"
          ]
        }
      }
    },
    {
      "LogName": "luvdisc hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_luvdiscegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyluvdisc",
              "AnimalId": "{{ModId}}_shinyluvdisc",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_luvdisc",
              "AnimalId": "{{ModId}}_luvdisc",
              "Condition": null
            }
          ]
        }
      }
    }
  ]
