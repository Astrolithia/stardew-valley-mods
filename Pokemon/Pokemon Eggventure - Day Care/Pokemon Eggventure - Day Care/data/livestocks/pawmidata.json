          "DisplayName": "{{i18n: pawmi}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_pawmiegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
