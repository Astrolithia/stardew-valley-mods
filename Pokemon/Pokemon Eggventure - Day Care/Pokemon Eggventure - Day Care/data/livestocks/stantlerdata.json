{
  "Changes": [
    {
      "LogName": "Load stantler textures",
      "Action": "Load",
      "Target": "{{ModId}}/stantler/stantler, {{ModId}}/stantler/shinystantler, {{ModId}}/stantler/wyrdeer, {{ModId}}/stantler/shinywyrdeer, {{ModId}}/stantler/stantleregg",
      "FromFile": "assets/livestocks/stantler/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_stantler data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_stantler": {
          "DisplayName": "{{i18n: stantler}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_stantleregg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: stantlerbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/stantler/wyrdeer",
          "BabyTexture": "{{ModId}}/stantler/stantler",
          "Sound": "{{ModId}}_wyrdeercry",
          "BabySound": "{{ModId}}_stantlercry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
