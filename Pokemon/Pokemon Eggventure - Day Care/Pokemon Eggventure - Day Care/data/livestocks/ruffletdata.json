    {
      "LogName": "rufflet hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_ruffletegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyrufflet",
              "AnimalId": "{{ModId}}_shinyrufflet",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_rufflet",
