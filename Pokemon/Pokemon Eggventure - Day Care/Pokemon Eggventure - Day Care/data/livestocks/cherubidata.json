{
  "Changes": [
    {
      "LogName": "Load cherubi textures",
      "Action": "Load",
      "Target": "{{ModId}}/cherubi/cherubi, {{ModId}}/cherubi/shinycherubi, {{ModId}}/cherubi/cherrim, {{ModId}}/cherubi/shinycherrim, {{ModId}}/cherubi/cherubiegg",
      "FromFile": "assets/livestocks/cherubi/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_cherubi data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_cherubi": {
          "DisplayName": "{{i18n: cherubi}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_cherubiegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: cherubibirthtext}}",
          "DaysToMature": "{{BabyDaysCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/cherubi/cherrim",
          "BabyTexture": "{{ModId}}/cherubi/cherubi",
          "Sound": "{{ModId}}_cherrimcry",
          "BabySound": "{{ModId}}_cherubicry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_miracleseed",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_cherubiegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceCommon}}"
        }
      }
    },
