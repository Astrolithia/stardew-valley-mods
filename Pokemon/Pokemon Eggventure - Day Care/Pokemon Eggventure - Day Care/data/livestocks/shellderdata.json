{
  "Changes": [
    {
      "LogName": "Load shellder textures",
      "Action": "Load",
      "Target": "{{ModId}}/shellder/shellder, {{ModId}}/shellder/shinyshellder, {{ModId}}/shellder/cloyster, {{ModId}}/shellder/shinycloyster, {{ModId}}/shellder/shellderegg",
