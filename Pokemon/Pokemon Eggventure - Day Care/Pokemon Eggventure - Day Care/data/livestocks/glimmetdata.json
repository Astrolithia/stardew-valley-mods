        }
      }
    },
    {
      "LogName": "glimmet hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_glimmetegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyglimmet",
              "AnimalId": "{{ModId}}_shinyglimmet",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_glimmet",
              "AnimalId": "{{ModId}}_glimmet",
              "Condition": null
            }
          ]
        }
      }
    }
