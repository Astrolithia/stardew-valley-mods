{
  "Changes": [
    {
      "LogName": "Load comfey textures",
      "Action": "Load",
      "Target": "{{ModId}}/comfey/comfey, {{ModId}}/comfey/shinycomfey, {{ModId}}/comfey/comfeyegg",
      "FromFile": "assets/livestocks/comfey/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_comfey data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_comfey": {
          "DisplayName": "{{i18n: comfey}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_comfeyegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: comfeybirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/comfey/comfey",
          "BabyTexture": "{{ModId}}/comfey/comfey",
          "Sound": "{{ModId}}_comfeycry",
          "BabySound": "{{ModId}}_comfeycry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
