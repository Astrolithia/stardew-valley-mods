{
  "Changes": [
    {
      "LogName": "Load chatot textures",
      "Action": "Load",
      "Target": "{{ModId}}/chatot/chatot, {{ModId}}/chatot/shinychatot, {{ModId}}/chatot/chatotegg",
      "FromFile": "assets/livestocks/chatot/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_chatot data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_chatot": {
          "DisplayName": "{{i18n: chatot}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_chatotegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: chatotbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/chatot/chatot",
          "BabyTexture": "{{ModId}}/chatot/chatot",
          "Sound": "{{ModId}}_chatotcry",
          "BabySound": "{{ModId}}_chatotcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_prettyfeather",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_chatotegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryRare}}"
        }
      }
    },
    {
      "LogName": "Add {{ModId}}_shinychatot data",
