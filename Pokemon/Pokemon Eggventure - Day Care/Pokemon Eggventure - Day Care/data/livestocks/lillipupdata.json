      "Entries": {
        "lillipupevolution": {
          "Id": "lillipupevolution",
          "Condition": "selph.ExtraAnimalConfig_ANIMAL_FRIENDSHIP {{Query: {{EvolutionHearts}} * 200}}",
          "TextureToUse": "{{ModId}}/lillipup/stoutland"
        }
      }
    },
