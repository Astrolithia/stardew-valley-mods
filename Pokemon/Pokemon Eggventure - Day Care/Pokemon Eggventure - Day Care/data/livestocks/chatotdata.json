    {
      "LogName": "chatot cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_chatotcry": {
          "ID": "{{ModId}}_chatotcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/chatot/chatotcry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "chatot egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_chatotegg": {
          "Name": "{{ModId}}_chatotegg",
          "DisplayName": "{{i18n: chatotegg}}",
          "Description": "{{i18n: chatotegg.d}}",
          "Texture": "{{ModId}}/chatot/chatotegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_travelingcart",
            "pkegg_type_flying",
            "pkegg_rarity_veryrare",
            "pkegg_chop_palmisland",
            "pkegg_shake_palmisland",
            "color_blue"
          ]
        }
      }
    },
    {
      "LogName": "chatot hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_chatotegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinychatot",
              "AnimalId": "{{ModId}}_shinychatot",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_chatot",
              "AnimalId": "{{ModId}}_chatot",
              "Condition": null
            }
          ]
        }
      }
    }
  ]
