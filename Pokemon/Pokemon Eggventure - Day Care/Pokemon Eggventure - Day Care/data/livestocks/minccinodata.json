      "FromFile": "assets/livestocks/minccino/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_minccino data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_minccino": {
          "DisplayName": "{{i18n: minccino}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_minccinoegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
