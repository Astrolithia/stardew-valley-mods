            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_mysticwater",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_chinchouegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceCommon}}"
        }
      }
    },
    {
