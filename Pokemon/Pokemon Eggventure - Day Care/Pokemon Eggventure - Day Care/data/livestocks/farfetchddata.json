    },
    {
      "LogName": "farfetchd hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_farfetchdegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyfarfetchd",
              "AnimalId": "{{ModId}}_shinyfarfetchd",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_farfetchd",
              "AnimalId": "{{ModId}}_farfetchd",
              "Condition": null
