{
  "Changes": [
    {
      "LogName": "Load grubbin textures",
      "Action": "Load",
      "Target": "{{ModId}}/grubbin/grubbin, {{ModId}}/grubbin/shinygrubbin, {{ModId}}/grubbin/charjabug, {{ModId}}/grubbin/shinycharjabug, {{ModId}}/grubbin/vikavolt, {{ModId}}/grubbin/shinyvikavolt, {{ModId}}/grubbin/grubbinegg",
      "FromFile": "assets/livestocks/grubbin/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_grubbin data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_grubbin": {
          "DisplayName": "{{i18n: grubbin}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_grubbinegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: grubbinbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/grubbin/charjabug",
          "BabyTexture": "{{ModId}}/grubbin/grubbin",
          "Sound": "{{ModId}}_vikavoltcry",
          "BabySound": "{{ModId}}_grubbincry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_shedshell",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_grubbinegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceVeryCommon}}"
        }
      }
    },
    {
