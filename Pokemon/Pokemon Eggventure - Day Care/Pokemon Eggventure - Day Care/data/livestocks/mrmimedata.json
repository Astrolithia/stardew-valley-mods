            "{{AbsoluteFilePath: assets/livestocks/mimejr/mrmimecry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "mrmime egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_mrmimeegg": {
          "Name": "{{ModId}}_mrmimeegg",
          "DisplayName": "{{i18n: mrmimeegg}}",
          "Description": "{{i18n: mrmimeegg.d}}",
          "Texture": "{{ModId}}/mimejr/mrmimeegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_travelingcart",
            "pkegg_type_ice",
            "pkegg_rarity_common",
            "color_poppyseed"
          ]
        }
      }
    },
    {
      "LogName": "mrmime hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_mrmimeegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinymrmime",
              "AnimalId": "{{ModId}}_shinymrmime",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_mrmime",
              "AnimalId": "{{ModId}}_mrmime",
              "Condition": null
            }
          ]
        }
