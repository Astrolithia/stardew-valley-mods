              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceCommon}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_shinyvulpix type flags",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/AnimalExtensionData",
      "TargetField": [
        "{{ModId}}_shinyvulpix"
      ],
      "Entries": {
        "IsHeater": true
      }
    },
    {
      "LogName": "vulpix cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_vulpixcry": {
          "ID": "{{ModId}}_vulpixcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/vulpix/vulpixcry.ogg}}"
          ]
        },
        "{{ModId}}_ninetalescry": {
          "ID": "{{ModId}}_ninetalescry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/vulpix/ninetalescry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "vulpix egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_vulpixegg": {
          "Name": "{{ModId}}_vulpixegg",
          "DisplayName": "{{i18n: vulpixegg}}",
          "Description": "{{i18n: vulpixegg.d}}",
          "Texture": "{{ModId}}/vulpix/vulpixegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_travelingcart",
            "pkegg_type_fire",
            "pkegg_rarity_common",
            "pkegg_mine_81_100_p5",
            "pkegg_mine_101_120_p5",
            "color_salmon"
          ]
        }
      }
    },
    {
      "LogName": "vulpix hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_vulpixegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyvulpix",
              "AnimalId": "{{ModId}}_shinyvulpix",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_vulpix",
              "AnimalId": "{{ModId}}_vulpix",
              "Condition": null
            }
          ]
        }
      }
    }
  ]
