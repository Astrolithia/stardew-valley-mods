{
  "Changes": [
    {
      "LogName": "Load larvesta textures",
      "Action": "Load",
      "Target": "{{ModId}}/larvesta/larvesta, {{ModId}}/larvesta/shinylarvesta, {{ModId}}/larvesta/volcarona, {{ModId}}/larvesta/shinyvolcarona, {{ModId}}/larvesta/larvestaegg",
