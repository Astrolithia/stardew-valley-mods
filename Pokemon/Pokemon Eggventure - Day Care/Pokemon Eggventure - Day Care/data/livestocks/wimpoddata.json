{
  "Changes": [
    {
      "LogName": "Load wimpod textures",
      "Action": "Load",
      "Target": "{{ModId}}/wimpod/wimpod, {{ModId}}/wimpod/shinywimpod, {{ModId}}/wimpod/golisopod, {{ModId}}/wimpod/shinygolisopod, {{ModId}}/wimpod/wimpodegg",
      "FromFile": "assets/livestocks/wimpod/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_wimpod data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_wimpod": {
          "DisplayName": "{{i18n: wimpod}}",
          "Gender": "MaleOrFemale",
          "House": "Barn",
          "RequiredBuilding": "Barn",
          "EggItemIds": [
            "{{ModId}}_wimpodegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysRare}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: wimpodbirthtext}}",
          "DaysToMature": "{{BabyDaysRare}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/wimpod/golisopod",
          "BabyTexture": "{{ModId}}/wimpod/wimpod",
          "Sound": "{{ModId}}_golisopodcry",
          "BabySound": "{{ModId}}_wimpodcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": true,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
          "ProduceItemIds": [
            {
              "Id": "Default",
              "Condition": null,
              "MinimumFriendship": 0,
              "ItemId": "{{ModId}}_shedshell",
              "HarvestType": "DropOverNight"
            }
          ],
          "DeluxeProduceItemIds": [
            {
              "Id": "Default",
              "Condition": "RANDOM {{EggLayingChance}}",
              "MinimumFriendship": 500,
              "ItemId": "{{ModId}}_wimpodegg",
              "HarvestType": "DropOverNight"
            }
          ],
          "SellPrice": "{{SellPriceRare}}"
        }
      }
    },
    {
      "LogName": "{{ModId}}_wimpod type flags",
      "Action": "EditData",
