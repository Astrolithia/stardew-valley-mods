      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_manaphyegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinymanaphy",
