    {
      "LogName": "zapdos cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_zapdoscry": {
          "ID": "{{ModId}}_zapdoscry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/zapdos/zapdoscry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "zapdos egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_zapdosegg": {
          "Name": "{{ModId}}_zapdosegg",
          "DisplayName": "{{i18n: zapdosegg}}",
          "Description": "{{i18n: zapdosegg.d}}",
          "Texture": "{{ModId}}/zapdos/zapdosegg",
          "Type": "Basic",
          "Category": -5,
          "Price": 50,
          "ContextTags": [
            "pkegg_item",
            "egg_item",
            "pkegg_type_electric",
            "pkegg_rarity_legendary",
            "pkegg_hardmine",
            "color_salmon"
          ]
        }
      }
    },
    {
      "LogName": "zapdos hatch",
      "Action": "EditData",
      "Target": "selph.ExtraAnimalConfig/EggExtensionData",
      "Entries": {
        "(O){{ModId}}_zapdosegg": {
          "AnimalSpawnList": [
            {
              "Id": "{{ModId}}_shinyzapdos",
              "AnimalId": "{{ModId}}_shinyzapdos",
              "Condition": "RANDOM {{ShinyChance}}"
            },
            {
              "Id": "{{ModId}}_zapdos",
              "AnimalId": "{{ModId}}_zapdos",
              "Condition": null
            }
          ]
        }
      }
    }
  ]
