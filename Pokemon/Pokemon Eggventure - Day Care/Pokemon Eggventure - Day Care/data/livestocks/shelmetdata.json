{
  "Changes": [
    {
      "LogName": "Load shelmet textures",
      "Action": "Load",
      "Target": "{{ModId}}/shelmet/shelmet, {{ModId}}/shelmet/shinyshelmet, {{ModId}}/shelmet/accelgor, {{ModId}}/shelmet/shinyaccelgor, {{ModId}}/shelmet/shelmetegg",
      "FromFile": "assets/livestocks/shelmet/{{TargetWithoutPath}}.png"
    },
    {
      "LogName": "Add {{ModId}}_shelmet data",
      "Action": "EditData",
      "Target": "Data/FarmAnimals",
      "Entries": {
        "{{ModId}}_shelmet": {
          "DisplayName": "{{i18n: shelmet}}",
          "Gender": "MaleOrFemale",
          "House": "Coop",
          "RequiredBuilding": "Coop",
          "EggItemIds": [
            "{{ModId}}_shelmetegg"
          ],
          "IncubationTime": "{{Query: {{IncubationDaysVeryCommon}} * 1440}}",
          "IncubatorParentSheetOffset": 1,
          "BirthText": "{{i18n: shelmetbirthtext}}",
          "DaysToMature": "{{BabyDaysVeryCommon}}",
          "CanGetPregnant": false,
          "Texture": "{{ModId}}/shelmet/accelgor",
          "BabyTexture": "{{ModId}}/shelmet/shelmet",
          "Sound": "{{ModId}}_accelgorcry",
          "BabySound": "{{ModId}}_shelmetcry",
          "SleepFrame": "0",
          "SpriteWidth": 32,
          "SpriteHeight": 32,
          "UseFlippedRightForLeft": true,
          "UseDoubleUniqueAnimationFrames": false,
          "ProfessionForHappinessBoost": 2,
          "ProfessionForQualityBoost": 2,
          "ProfessionForFasterProduce": 2,
          "CanSwim": false,
          "ShowInSummitCredits": true,
          "DaysToProduce": "1",
