{
  "Changes": [
    {
      "LogName": "Load pawmi textures",
      "Action": "Load",
      "Target": "{{ModId}}/pawmi/pawmi, {{ModId}}/pawmi/shinypawmi, {{ModId}}/pawmi/pawmo, {{ModId}}/pawmi/shinypawmo, {{ModId}}/pawmi/pawmot, {{ModId}}/pawmi/shinypawmot, {{ModId}}/pawmi/pawmiegg",
