{
  "Changes": [
    {
      "LogName": "Load treecko textures",
      "Action": "Load",
      "Target": "{{ModId}}/treecko/treecko, {{ModId}}/treecko/shinytreecko, {{ModId}}/treecko/grovyle, {{ModId}}/treecko/shinygrovyle, {{ModId}}/treecko/sceptile, {{ModId}}/treecko/shinysceptile, {{ModId}}/treecko/treeckoegg",
