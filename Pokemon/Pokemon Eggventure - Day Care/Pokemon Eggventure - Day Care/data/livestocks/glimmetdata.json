    {
      "LogName": "glimmet cries",
      "Action": "EditData",
      "Target": "Data/AudioChanges",
      "Entries": {
        "{{ModId}}_glimmetcry": {
          "ID": "{{ModId}}_glimmetcry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/glimmet/glimmetcry.ogg}}"
          ]
        },
        "{{ModId}}_glimmoracry": {
          "ID": "{{ModId}}_glimmoracry",
          "Category": "Sound",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/livestocks/glimmet/glimmoracry.ogg}}"
          ]
        }
      }
    },
    {
      "LogName": "glimmet egg",
      "Action": "EditData",
      "Target": "Data/Objects",
      "Entries": {
        "{{ModId}}_glimmetegg": {
          "Name": "{{ModId}}_glimmetegg",
          "DisplayName": "{{i18n: glimmetegg}}",
          "Description": "{{i18n: glimmetegg.d}}",
